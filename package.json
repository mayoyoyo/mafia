{
  "name": "mafia-game",
  "version": "1.0.0",
  "description": "Multiplayer Mafia party game PWA for mobile",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "generate-voices": "bun run scripts/generate-voices.ts",
    "generate-voices:dry": "bun run scripts/generate-voices.ts --dry-run",
    "dashboard": "bun run tools/test-dashboard/server.ts",
    "chrome-grid": "bun run tests/playtest/chrome-grid.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@types/bun": "latest",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  }
}
